{
  "crons": [
    {
      "path": "/api/weekly-backup",
      "schedule": "0 0 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/report.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
